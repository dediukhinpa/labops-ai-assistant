# Окружение диспетчера общего бота. Класть в /etc/labops-plugin/dispatcher.env
# с правами 600 и владельцем сервисного пользователя: здесь лежит токен.

# Токен бота приложения. Им владеет ТОЛЬКО диспетчер: приём в Telegram
# эксклюзивен, и второй читатель начнёт воровать чужие сообщения.
TELEGRAM_BOT_TOKEN=

# Состояние диспетчера: курсор апдейтов, dead-letter, pid-лок токена.
DISPATCHER_STATE_DIR=/home/<service-user>/.claude-lab/shared/state/telegram-dispatcher

# Таблица маршрутов telegram_id → агент.
DISPATCHER_ROUTES_PATH=/home/<service-user>/.claude-lab/shared/state/telegram-dispatcher/routes.json

# Каталог состояния агентов роя: отсюда читаются порт и bearer приёмника.
DISPATCHER_AGENT_STATE_ROOT=/home/<service-user>/.claude-lab/shared/state
