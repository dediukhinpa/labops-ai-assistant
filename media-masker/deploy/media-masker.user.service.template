[Unit]
Description=LabOps media-masker (user unit, OCR masking of images and PDFs, 127.0.0.1:8320)
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
# Каталог подпроекта media-masker/ с готовым .venv (ставит agent-architecture/orchestration/
# pii-setup.sh host).
WorkingDirectory=__INSTALL_DIR__
# API-токен и пути Tesseract: файл с правами 600, вне репозитория.
EnvironmentFile=__ENV_FILE__
ExecStart=__INSTALL_DIR__/.venv/bin/python -m media_masker
Restart=on-failure
RestartSec=5
# Замер 04.11.2026: два одновременных запроса на страницах A4 - до ~1,8 ГБ вместе с дочерним
# tesseract (он в том же cgroup), поэтому лимит с запасом.
MemoryMax=2G
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
