# Образец EnvironmentFile для media-masker.service.
# Копия кладётся вне репозитория (например ~/secrets/media-masker.env), chmod 600.
# Значения секретов здесь не хранятся.

# Обязателен: общий Bearer-секрет API (random, >= 32 байт, например
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))')
MEDIA_MASKER_API_TOKEN=

MEDIA_MASKER_HOST=127.0.0.1
MEDIA_MASKER_PORT=8310

# Бинарь Tesseract и языковые данные. С apt (tesseract-ocr, tesseract-ocr-rus) пути
# по умолчанию верны и обе строки можно не задавать.
# MEDIA_MASKER_TESSERACT_CMD=/usr/bin/tesseract
# TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
MEDIA_MASKER_OCR_LANGS=rus+eng

# Предел страниц PDF (сверх - 413) и число одновременных обработок
MEDIA_MASKER_MAX_PDF_PAGES=20
MEDIA_MASKER_MAX_CONCURRENCY=2
# Предел времени одного запуска Tesseract, секунд
MEDIA_MASKER_OCR_TIMEOUT_S=60

# Закрашивать названия организаций (как PSEUDONYMIZER_MASK_LEGAL_ENTITY)
MEDIA_MASKER_MASK_LEGAL_ENTITY=true
# Словарь контактов, по одному на строку (тот же файл, что у pseudonymizer)
# MEDIA_MASKER_CONTACTS_FILE=
