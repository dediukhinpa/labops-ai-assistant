# Копия этого файла кладётся вне репозитория (например ~/secrets/voice-transcriber.env),
# chmod 600. Значения секретов здесь не хранятся.

# Обязателен всегда: общий Bearer-секрет API (random, >= 32 знаков, например
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))')
VOICE_TRANSCRIBER_API_TOKEN=

# Каталог с весами моделей ВНЕ репозитория; веса -- в <каталог>/faster-whisper-<модель>
# (скачать: см. README, «Модели»). Сервис работает офлайн и сам ничего не качает.
VOICE_MODEL_DIR=/home/labops/voice-models

# Модель: tiny | base | small | medium (выбор по замеру -- README, «Замеры»)
VOICE_MODEL=small

# Язык по умолчанию; auto -- определять по аудио (медленнее и чаще ошибается на коротких)
VOICE_LANGUAGE=ru

# Ширина луча: 1 (жадно) вдвое быстрее 5; 5 точнее, но 60 с звука считаются ~75 с
VOICE_BEAM_SIZE=1
VOICE_CPU_THREADS=4
# Предел длительности аудио, секунд (дольше -- 413)
VOICE_MAX_AUDIO_SEC=180
# Предел тела запроса, байт (Bot API отдаёт файлы до 20 МБ)
VOICE_MAX_BODY_BYTES=20971520
# Сколько запрос ждёт своей очереди (расшифровка идёт по одной), секунд; потом 503
VOICE_QUEUE_TIMEOUT_SEC=20

VOICE_TRANSCRIBER_HOST=127.0.0.1
VOICE_TRANSCRIBER_PORT=8310
