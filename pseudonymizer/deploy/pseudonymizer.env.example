# Копия этого файла кладётся вне репозитория (например ~/.claude/secrets/pseudonymizer.env),
# chmod 600. Значения секретов здесь не хранятся.

# Обязателен всегда: общий Bearer-секрет API (random, >= 32 байт, например
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))')
PSEUDONYMIZER_API_TOKEN=

# Хранилище замен: memory (по умолчанию, на диск не пишется) или sqlite
PSEUDONYMIZER_STORE=memory

# Только для sqlite (обязателен): ключ Fernet, генерируется один раз, потеря = таблица нечитаема
# PSEUDONYMIZER_KEY=
# PSEUDONYMIZER_DB=data/pseudonymizer.sqlite3

# Часов без обращений до удаления треда (0 -- не удалять)
PSEUDONYMIZER_RETENTION_HOURS=24

# Маскировать названия организаций (решение владельца: включено)
PSEUDONYMIZER_MASK_LEGAL_ENTITY=true

PSEUDONYMIZER_HOST=127.0.0.1
PSEUDONYMIZER_PORT=8300
