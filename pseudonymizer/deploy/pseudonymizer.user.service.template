[Unit]
Description=LabOps pseudonymizer (user unit, PII masking service, 127.0.0.1:8300)
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
# Каталог подпроекта pseudonymizer/ с готовым .venv.
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=__ENV_FILE__
ExecStart=__INSTALL_DIR__/.venv/bin/python -m pseudonymizer
Restart=on-failure
RestartSec=5
# Замер 04.11.2026: пик ~306 МБ; 768 МБ - запас ~2,5x.
MemoryMax=768M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
