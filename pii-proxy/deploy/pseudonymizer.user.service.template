[Unit]
Description=LabOps pseudonymizer (user unit, PII masking service, 127.0.0.1:8300)
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
# Каталог рабочей копии labops-pii (labops_pii/ и .venv; ставит pii-setup.sh host).
WorkingDirectory=__INSTALL_DIR__
# Код - вендоренная labops-pii (vendor/labops-pii), без pip-пакета: подключается через
# PYTHONPATH. С labops-pii 1.0.0 профилей нет: маршруты, которые нужны pii-proxy
# (удаление треда, boot_id в /health, падежные метки), включаются явно ниже;
# env-файл читается позже и может их переопределить. Адреса - PSEUDONYMIZER_ADDRESS_MASK
# в env-файле.
Environment=PYTHONPATH=__INSTALL_DIR__
Environment=PSEUDONYMIZER_ENABLE_DELETE_THREADS=on
Environment=PSEUDONYMIZER_ENABLE_EXPOSE_BOOT_ID=on
Environment=PSEUDONYMIZER_ENABLE_CASE_LABELS=on
EnvironmentFile=__ENV_FILE__
ExecStart=__INSTALL_DIR__/.venv/bin/python -m labops_pii
Restart=on-failure
RestartSec=5
# Замер 04.11.2026: пик ~306 МБ; 768 МБ - запас ~2,5x.
MemoryMax=768M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
