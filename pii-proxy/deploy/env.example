# Образец EnvironmentFile для pii-proxy@<агент>.service.
# Реальный файл: ~/.claude-lab/<агент>/.claude/secrets/pii-proxy.env (права 600, вне репозитория).
# Токен сервиса не писать сюда: реальное значение только в секретном файле.

# Порт прокси этого агента (по индексу в списке агентов роя, рядом с портом webhook).
PII_PROXY_PORT=6300
PII_PROXY_HOST=127.0.0.1
PII_PROXY_UPSTREAM=https://api.anthropic.com
# Идентификатор агента: префикс треда `<agent>:<session_id>`.
PII_PROXY_AGENT_ID=developer
PSEUDONYMIZER_URL=http://127.0.0.1:8300
# Общий Bearer-токен сервиса (PSEUDONYMIZER_API_TOKEN сервиса).
PSEUDONYMIZER_API_TOKEN=
PSEUDONYMIZER_TIMEOUT_MS=10000
# Вложения (image, PDF): mask - через media-masker (по умолчанию: OCR, закраска ПДн, PDF текстом),
# strip - заглушка вместо блока, reject - отказ 422, passthrough - как есть (ПДн уйдут в модель!).
PII_PROXY_IMAGE_POLICY=mask
# Падежные метки во входе ([PERSON_1|datv] у ФИО в косвенном падеже): true (по умолчанию) или
# false (поле case_labels не отправляется, для сервиса без этой возможности).
PII_PROXY_CASE_LABELS=true
# Сервис media-masker (media-masker/README.md). Токен сюда не писать: только в секретный файл.
MEDIA_MASKER_URL=http://127.0.0.1:8310
MEDIA_MASKER_API_TOKEN=
# OCR страниц PDF долгий: таймаут вызова больше, чем у pseudonymizer.
MEDIA_MASKER_TIMEOUT_MS=120000
