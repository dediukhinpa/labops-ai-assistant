[Unit]
Description=LabOps media-masker (user unit, OCR masking of images and PDFs, 127.0.0.1:8320)
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
# Каталог рабочей копии labops-pii (labops_pii/ и .venv; ставит pii-setup.sh host).
WorkingDirectory=__INSTALL_DIR__
# API-токен и пути Tesseract: файл с правами 600, вне репозитория.
# Код - вендоренная labops-pii (vendor/labops-pii), без pip-пакета: подключается через
# PYTHONPATH. С labops-pii 1.0.0 профилей нет (LABOPS_PII_PROFILE - ошибка старта);
# адреса - MEDIA_MASKER_ADDRESS_MASK или PSEUDONYMIZER_ADDRESS_MASK, по умолчанию вкл.
Environment=PYTHONPATH=__INSTALL_DIR__
EnvironmentFile=__ENV_FILE__
ExecStart=__INSTALL_DIR__/.venv/bin/python -m labops_pii.media.mask
Restart=on-failure
RestartSec=5
# Замер 04.11.2026: два одновременных запроса на страницах A4 - до ~1,8 ГБ вместе с дочерним
# tesseract (он в том же cgroup), поэтому лимит с запасом.
MemoryMax=2G
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
