[Unit]
Description=LabOps media-masker (OCR masking of images and PDFs, 127.0.0.1:8320)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=__USER__
# Каталог рабочей копии labops-pii (labops_pii/ и .venv; ставит pii-setup.sh host).
WorkingDirectory=__INSTALL_DIR__
# API-токен и пути Tesseract -- файл с правами 600, вне репозитория.
# Образец: media-masker.env.example
# Код - вендоренная labops-pii (vendor/labops-pii), без pip-пакета: подключается через
# PYTHONPATH. Профиль labops - значения по умолчанию проекта; адреса включает
# PSEUDONYMIZER_ADDRESS_MASK в env-файле.
Environment=PYTHONPATH=__INSTALL_DIR__
Environment=LABOPS_PII_PROFILE=labops
EnvironmentFile=__ENV_FILE__
ExecStart=__INSTALL_DIR__/.venv/bin/python -m labops_pii.media.mask
Restart=on-failure
RestartSec=5
# Замер 04.11.2026: после старта RSS ~260 МБ (детектор Natasha), после фото 1600x1200 ~280 МБ
# плюс дочерний tesseract ~340 МБ; пять страниц A4 (300 dpi) -- процесс ~460 МБ + tesseract.
# Два одновременных запроса (MEDIA_MASKER_MAX_CONCURRENCY=2) на страницах A4 -- до ~1,8 ГБ.
# Tesseract - дочерний процесс и считается в тот же cgroup, поэтому лимит с запасом.
MemoryMax=2G
# Рендер страниц и OCR -- CPU; не отнимаем всё у остальных сервисов роя
CPUQuota=200%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# Сервис ничего не пишет на диск: картинки идут через stdin Tesseract.

[Install]
WantedBy=multi-user.target
